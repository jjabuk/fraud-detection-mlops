# The image carries source, locked dependencies and the pinned artefacts it reads by
# relative path. Everything else is either large, secret, or reproducible.
.git
.github
.venv
.dagster_home
.pytest_cache
.ruff_cache
__pycache__
**/__pycache__
*.pyc
.env
.env.example
data/
# The whole directory, not just raw/: it also holds generated submissions, and the image
# has no use for any of it. Sending it as build context cost 1.3 GB per build.
kaggle/
models/
eda/
docs/
iaac/
tests/
*.duckdb
*.csv
*.parquet
.DS_Store
